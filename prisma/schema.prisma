// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TENANT
}

enum AdminStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionPlan {
  FREE
  BASIC
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum UnitStatus {
  OCCUPIED
  VACANT
  MAINTENANCE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  DEBIT_CARD
  CREDIT_CARD
  CHECK
}

enum ExpenseDistributionType {
  EQUAL
  BY_SIZE
  CUSTOM
}

enum DocumentType {
  CONTRACT
  REGULATION
  INVOICE
  RECEIPT
  OTHER
}

// ============================================
// MODELS
// ============================================

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  name              String
  phone             String?
  role              UserRole @default(TENANT)
  emailVerified     DateTime?
  verificationToken String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  adminProfile          AdminProfile?
  managedBuildings      Building[]         @relation("BuildingAdmin")
  tenant                Tenant?
  createdTasks          Task[]             @relation("TaskCreator")
  createdAnnouncements  Announcement[]     @relation("AnnouncementCreator")
  uploadedDocuments     Document[]         @relation("DocumentUploader")
  announcementReads     AnnouncementRead[]
  sentInvitations       TenantInvitation[] @relation("InvitationSender")

  @@index([email])
  @@index([role])
  @@index([verificationToken])
  @@index([emailVerified])
}

model Building {
  id         String   @id @default(uuid())
  name       String
  address    String
  city       String
  state      String?
  zipCode    String?
  floors     Int
  totalUnits Int
  adminId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  admin             User               @relation("BuildingAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  units             Unit[]
  tenants           Tenant[]
  announcements     Announcement[]
  tasks             Task[]
  expenses          Expense[]
  payments          Payment[]
  documents         Document[]
  tenantInvitations TenantInvitation[]

  @@index([adminId])
  @@index([name])
}

model Unit {
  id         String     @id @default(uuid())
  buildingId String
  number     String // e.g., "101", "2A", "PH1"
  floor      Int
  size       Float? // m2
  status     UnitStatus @default(VACANT)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Relations
  building          Building           @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenants           Tenant[]
  tasks             Task[]
  payments          Payment[]
  documents         Document[]
  tenantInvitations TenantInvitation[]

  @@unique([buildingId, number])
  @@index([buildingId])
  @@index([status])
}

model Tenant {
  id         String    @id @default(uuid())
  userId     String    @unique
  unitId     String
  buildingId String
  startDate  DateTime
  endDate    DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit     Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  building Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([unitId])
  @@index([buildingId])
  @@index([isActive])
}

model Announcement {
  id          String               @id @default(uuid())
  buildingId  String
  title       String
  content     String               @db.Text
  priority    AnnouncementPriority @default(NORMAL)
  createdById String
  targetUnits String[] // Array of unit IDs (empty = all units)
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // Relations
  building Building           @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  createdBy User              @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Cascade)
  reads    AnnouncementRead[]

  @@index([buildingId])
  @@index([createdAt])
  @@index([priority])
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  // Relations
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
}

model Task {
  id          String       @id @default(uuid())
  buildingId  String
  unitId      String?
  title       String
  description String       @db.Text
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  assignedTo  String? // Could be external contractor or staff
  createdById String
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  building  Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unit      Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdBy User     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([buildingId])
  @@index([unitId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

model Expense {
  id               String                   @id @default(uuid())
  buildingId       String
  description      String
  amount           Float
  date             DateTime
  category         String
  distributionType ExpenseDistributionType  @default(EQUAL)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  // Relations
  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId])
  @@index([date])
  @@index([category])
}

model Payment {
  id         String        @id @default(uuid())
  unitId     String
  tenantId   String
  buildingId String
  amount     Float
  dueDate    DateTime
  status     PaymentStatus @default(PENDING)
  period     String // e.g., "2024-01" for January 2024
  notes      String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Relations
  unit           Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  building       Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  paymentRecords PaymentRecord[]

  @@index([unitId])
  @@index([tenantId])
  @@index([buildingId])
  @@index([status])
  @@index([period])
  @@index([dueDate])
}

model PaymentRecord {
  id        String        @id @default(uuid())
  paymentId String
  amount    Float
  paidAt    DateTime      @default(now())
  method    PaymentMethod
  receipt   String? // URL or reference to receipt
  notes     String?       @db.Text
  createdAt DateTime      @default(now())

  // Relations
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([paidAt])
}

model Document {
  id         String       @id @default(uuid())
  buildingId String
  unitId     String?
  name       String
  url        String
  type       DocumentType @default(OTHER)
  uploadedBy String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Relations
  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unit     Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  uploader User     @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([buildingId])
  @@index([unitId])
  @@index([type])
}

model AdminProfile {
  id              String            @id @default(uuid())
  userId          String            @unique
  status          AdminStatus       @default(PENDING)
  company         String?

  // Subscription & Limits
  plan            SubscriptionPlan  @default(FREE)
  maxBuildings    Int               @default(1)
  maxUnits        Int               @default(10)
  maxInvitations  Int               @default(10)

  // Trial & Subscription
  trialEndsAt         DateTime?
  subscriptionEndsAt  DateTime?

  // Current usage counters
  currentBuildings Int @default(0)
  currentUnits     Int @default(0)

  // Payment integration
  stripeCustomerId      String?
  stripeSubscriptionId  String?

  // Audit
  suspendedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([plan])
}

model TenantInvitation {
  id         String    @id @default(uuid())
  email      String
  token      String    @unique
  buildingId String
  unitId     String
  invitedBy  String
  startDate  DateTime
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  // Relations
  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  inviter  User     @relation("InvitationSender", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
  @@index([unitId])
  @@index([buildingId])
  @@index([acceptedAt])
}
